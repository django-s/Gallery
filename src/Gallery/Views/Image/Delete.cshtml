@using Gallery
@model Gallery.Models.Image.DeleteImagesViewModel
@inject Configuration Configuration

@{
    ViewData["Title"] = "Delete Images";
}

<h1>@ViewData["Title"]</h1>

<form method="post">
    @for (var i = 0; i < Model.Images.Count; i++)
    {
        <div style="margin-bottom: 20px">
            <input asp-for="@Model.DoDelete[i]" type="checkbox" style="margin-right: 25px">
            <input asp-for="@Model.ImageIds[i]" style="display:none" value="@Model.Images[i].Id">
            <img src="@Configuration.ImageRequestPath/@Model.Images[i].Url" alt="@Model.Images[i].Name" height="150px">
        </div>
    }

    <button type="submit" class="btn btn-primary">Delete</button>
</form>

